# Loyallia Frontend — Environment Variables
# Copy to .env.local for local development.
# NEVER commit .env.local to version control.

# API URL for SSR (server-side rendering) — internal Docker network
NEXT_INTERNAL_API_URL=http://localhost:33905

# API URL for browser requests — proxied through Next.js rewrites
NEXT_PUBLIC_API_URL=

# QR code generation service (optional)
NEXT_PUBLIC_QR_SERVICE_URL=

# WhatsApp share link (optional)
NEXT_PUBLIC_WHATSAPP_SHARE_URL=

# ── Mapas — OBLIGATORIO para funciones de mapa (LocationPicker / LocationMap) ──
# Estas tres variables son REQUERIDAS para los mapas. Si falta alguna, los
# componentes de mapa muestran un aviso de configuración en español en lugar
# de fallar en silencio (búsqueda rota / marcador invisible).
# Nominatim geocoding (búsqueda de direcciones)
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Nominatim reverse geocoding (coordenadas → dirección)
NEXT_PUBLIC_NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
# Base URL que sirve los íconos de marcador de Leaflet (debe exponer
# marker-icon.png, marker-icon-2x.png y marker-shadow.png)
NEXT_PUBLIC_LEAFLET_ICON_URL=https://unpkg.com/leaflet@1.9.4/dist/images

# Partner upgrade URL (optional)
NEXT_PUBLIC_UPGRADE_URL=

# Partner portal URL (optional)
NEXT_PUBLIC_PARTNER_URL=

# App URL for program links (optional)
NEXT_PUBLIC_APP_URL=
