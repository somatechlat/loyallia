{
  "name": "loyallia-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "rm -f .next/cache/.tsbuildinfo tsconfig.tsbuildinfo && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:fast": "playwright test --grep-invert '@slow|Phone Verification'",
    "test:e2e:smoke": "playwright test --project=auth --project=programs --project=customers --project=analytics",
    "test:e2e:auth": "playwright test --project=auth",
    "test:e2e:programs": "playwright test --project=programs",
    "test:e2e:customers": "playwright test --project=customers",
    "test:e2e:team": "playwright test --project=team",
    "test:e2e:locations": "playwright test --project=locations",
    "test:e2e:analytics": "playwright test --project=analytics",
    "test:e2e:automation": "playwright test --project=automation",
    "test:e2e:campaigns": "playwright test --project=campaigns",
    "test:e2e:settings": "playwright test --project=settings-billing",
    "test:e2e:scanner": "playwright test --project=scanner",
    "test:e2e:superadmin": "playwright test --project=superadmin",
    "test:e2e:wallet": "playwright test --project=wallet",
    "test:e2e:whatsapp": "playwright test --project=whatsapp",
    "test:e2e:security": "playwright test --project=security",
    "test:e2e:role-isolation": "playwright test --project=role-isolation",
    "test:e2e:phone": "playwright test --project=phone",
    "test:e2e:billing": "playwright test --project=billing",
    "test:e2e:external": "playwright test --project=external-providers",
    "test:e2e:ci": "playwright test --project=auth --project=programs --project=customers --project=superadmin --project=role-isolation",
    "test:all": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@testing-library/dom": "^10.4.1",
    "@types/leaflet": "^1.9.21",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "html5-qrcode": "^2.3.8",
    "js-cookie": "^3.0.5",
    "leaflet": "^1.9.4",
    "next": "^14.2.35",
    "postcss": "^8.4.47",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.7",
    "swr": "^2.2.5",
    "tailwindcss": "3.4.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "tailwindcss": "3.4.14"
  }
}
