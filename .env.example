# =============================================================================
# Loyallia — Environment Configuration Template
# =============================================================================
# ZERO-SECRET POLICY: No passwords, tokens, keys, or credentials here.
# ALL secrets live exclusively in HashiCorp Vault (vault_data volume).
#
# FIRST-TIME SETUP:
#   1. cp .env.example .env
#   2. docker compose up vault -d
#   3. Seed Vault: docker compose exec vault vault kv put -mount=secret \
#        loyallia/production secret_key="$(openssl rand -base64 48)" \
#        postgres_password="$(openssl rand -base64 24)" \
#        redis_url="redis://:$(openssl rand -base64 24)@redis:6379/0" ...
#   4. docker compose up -d
# =============================================================================

# --- Vault ---
VAULT_ADDR=http://vault:8200
VAULT_SECRET_PATH=secret/data/loyallia/production

# --- Django ---
DJANGO_SETTINGS_MODULE=loyallia.settings.development
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Infrastructure endpoints (no credentials) ---
PGBOUNCER_URL=postgres://loyallia@pgbouncer:6432/loyallia
MINIO_ENDPOINT=http://minio:9000

# --- App URLs ---
APP_URL=http://localhost:33905
FRONTEND_URL=http://localhost:33906
NEXT_PUBLIC_API_URL=http://localhost:33905
