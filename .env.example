# =============================================================================
# Loyallia — LOCAL DEVELOPMENT Environment Variables
# =============================================================================
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your development values
#   docker compose up -d
#
# IMPORTANT:
#   - This file is the LOCAL Vault bootstrap source.
#   - The vault-init container reads these values and seeds them into Vault.
# Loyallia — LOCAL DEVELOPMENT Vault Bootstrap
# These values are used ONLY by the vault-init container to seed Vault.
# The Django app reads secrets FROM Vault, NOT from this file.
# For PRODUCTION, Vault must be pre-seeded by the ops team. Do NOT deploy this file.
#
# SECURITY:
#   - .env is gitignored and must NEVER be committed.
#   - Generate fresh secrets for each environment.
# =============================================================================

# --- Vault Configuration ---
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=loyallia-vault-root-token  # DEV ONLY — production uses VAULT_TOKEN_FILE
VAULT_SECRET_PATH=secret/data/loyallia/production

# --- Django Settings ---
DJANGO_SETTINGS_MODULE=loyallia.settings.production
DEBUG=False
ALLOWED_HOSTS=localhost,loyallia.com

# --- Infrastructure (no passwords — those go through Vault) ---
PGBOUNCER_URL=postgres://loyallia@pgbouncer:6432/loyallia
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000

# --- Public App URLs ---
APP_URL=https://loyallia.com
FRONTEND_URL=https://app.loyallia.com
NEXT_PUBLIC_API_URL=https://api.loyallia.com

# --- Database ---
POSTGRES_USER=loyallia
POSTGRES_DB=loyallia


