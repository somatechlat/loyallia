# =============================================================================
# Loyallia Environment Variables
# Copy this file to .env and fill in real values for your environment.
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
DEBUG=False
DJANGO_SETTINGS_MODULE=loyallia.settings.production
SECRET_KEY=change_me_to_a_random_50_char_string

# -----------------------------------------------------------------------------
# Hosts / CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed hosts. NO wildcards in production.
ALLOWED_HOSTS=rewards.loyallia.com,api.rewards.loyallia.com

# Comma-separated list of CORS origins
CORS_ALLOWED_ORIGINS=https://rewards.loyallia.com,https://app.loyallia.com

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=loyallia
POSTGRES_DB=loyallia
# POSTGRES_PASSWORD is fetched from Vault in production.
# For local dev, you may set it here or use the bootstrap script.
POSTGRES_PASSWORD=

# Direct database URL (port 5432) for migrations
DATABASE_URL=postgres://loyallia@postgres:5432/loyallia
DATABASE_DIRECT_URL=postgres://loyallia@postgres:5432/loyallia

# PgBouncer URL (port 6432) for application traffic
PGBOUNCER_URL=postgres://loyallia@pgbouncer:6432/loyallia

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://:your_redis_password@redis:6379/0

# -----------------------------------------------------------------------------
# Celery
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://:your_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:your_redis_password@redis:6379/2

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_PASSES=passes
MINIO_BUCKET_ASSETS=assets

# -----------------------------------------------------------------------------
# Vault
# -----------------------------------------------------------------------------
VAULT_ADDR=https://vault:8200
VAULT_CACERT=/run/loyallia-vault/ca.crt
VAULT_TOKEN_FILE=/run/loyallia-vault/app-token
VAULT_SECRET_PATH=secret/data/loyallia/production

# -----------------------------------------------------------------------------
# Apple Wallet
# -----------------------------------------------------------------------------
APPLE_WALLET_MODE=vault
APPLE_WALLET_ENABLED=false

# -----------------------------------------------------------------------------
# Google Wallet / OAuth
# -----------------------------------------------------------------------------
GOOGLE_WALLET_MODE=vault
GOOGLE_WALLET_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://rewards.loyallia.com/api/v1/auth/google/callback/

# -----------------------------------------------------------------------------
# Payment Gateway
# -----------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=bendo
PAYMENT_GATEWAY_BASE_URL=https://checkout.placetopay.com
PAYMENT_GATEWAY_ENABLED=false

# -----------------------------------------------------------------------------
# Email (Mailjet)
# -----------------------------------------------------------------------------
EMAIL_HOST=in-v3.mailjet.com
EMAIL_PORT=587
EMAIL_FROM=noreply@loyallia.com
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=noreply@loyallia.com

# -----------------------------------------------------------------------------
# Sentry Error Tracking
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# WhatsApp Bridge
# -----------------------------------------------------------------------------
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001

# -----------------------------------------------------------------------------
# SSL Certificates (production host paths)
# -----------------------------------------------------------------------------
SSL_CERT_PATH=./certs/vault.crt
SSL_KEY_PATH=./certs/vault.key

# -----------------------------------------------------------------------------
# Application URL (used for Wallet web service URL derivation)
# -----------------------------------------------------------------------------
APP_URL=https://rewards.loyallia.com
