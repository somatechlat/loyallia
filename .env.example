# =============================================================================
# Loyallia — LOCAL DEVELOPMENT Environment Variables
# =============================================================================
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your development values
#   docker compose up -d
#
# IMPORTANT:
#   - This file is the LOCAL Vault bootstrap source.
#   - The vault-init container reads these values and seeds them into Vault.
#   - The Django app reads secrets FROM Vault, NOT from these env vars.
#   - For PRODUCTION, Vault must be pre-seeded by the ops team. Do NOT use .env.
#
# SECURITY:
#   - .env is gitignored and must NEVER be committed.
#   - Generate fresh secrets for each environment.
#   - Use `openssl rand -base64 48` or `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# =============================================================================

# --- Vault Configuration ---
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=loyallia-vault-root-token
VAULT_SECRET_PATH=secret/data/loyallia/production

# --- Django Settings ---
DJANGO_SETTINGS_MODULE=loyallia.settings.development
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Infrastructure (no passwords — those go through Vault) ---
PGBOUNCER_URL=postgres://loyallia@pgbouncer:6432/loyallia
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000

# --- Public App URLs ---
APP_URL=http://localhost:33905
FRONTEND_URL=http://localhost:33906
NEXT_PUBLIC_API_URL=http://localhost:33905

# --- Secrets (seeded into Vault by vault-init container) ---
# Generate fresh values — do NOT reuse these examples!
SECRET_KEY=__GENERATE_WITH_openssl_rand_-base64_48__
JWT_SECRET_KEY=__GENERATE_WITH_openssl_rand_-base64_32__
POSTGRES_PASSWORD=__GENERATE_WITH_openssl_rand_-base64_24__
REDIS_PASSWORD=__GENERATE_WITH_openssl_rand_-base64_24__
MINIO_ROOT_USER=loyallia_minio_admin
MINIO_ROOT_PASSWORD=__GENERATE_WITH_openssl_rand_-base64_24__
PASS_HMAC_SECRET=__GENERATE_WITH_openssl_rand_-hex_32__

# --- Database ---
POSTGRES_USER=loyallia
POSTGRES_DB=loyallia

# --- Google OAuth 2.0 (leave empty if not using Google login) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Payment Gateway (leave empty if not using payments) ---
PAYMENT_GATEWAY_LOGIN=
PAYMENT_GATEWAY_TRAN_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# --- Email (leave empty for console backend in development) ---
EMAIL_HOST_PASSWORD=
