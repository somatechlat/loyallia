# Vault Bootstrap Environment Variables
# These variables are only used by the deploy/vault/init.sh script 
# to seed HashiCorp Vault on the first boot. 
# They are not read directly by the Django backend.

# Base infrastructure secrets
_SECRET_KEY=dummy_secret_key_change_me
_POSTGRES_PASSWORD=dummy_postgres_password
_REDIS_URL=redis://localhost:6379/0
_CELERY_BROKER_URL=redis://localhost:6379/1
_CELERY_RESULT_BACKEND=redis://localhost:6379/2
_MINIO_ROOT_USER=minio_user
_MINIO_ROOT_PASSWORD=minio_password
_JWT_SECRET_KEY=dummy_jwt_secret_change_me
_PASS_HMAC_SECRET=dummy_hmac_secret_change_me

# Google Credentials
_GOOGLE_OAUTH_CLIENT_ID=
_GOOGLE_OAUTH_CLIENT_SECRET=
_GOOGLE_WALLET_ISSUER_ID=
_GOOGLE_SERVICE_ACCOUNT_JSON=

# Payment Gateway (Manual is default)
_PAYMENT_GATEWAY_ENABLED=false
_PAYMENT_GATEWAY_PROVIDER=manual
_PAYMENT_GATEWAY_LOGIN=
_PAYMENT_GATEWAY_TRAN_KEY=
_PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Email (SMTP)
_EMAIL_HOST_USER=your_email@domain.com
_EMAIL_HOST_PASSWORD=your_email_password

# Apple Wallet Credentials
_APPLE_PASS_TYPE_IDENTIFIER=
_APPLE_TEAM_IDENTIFIER=
_APPLE_CERT_PEM=
_APPLE_CERT_KEY_PEM=
_APPLE_WWDR_CERT_PEM=

# Feature Toggles
_GOOGLE_WALLET_ENABLED=true
_APPLE_WALLET_ENABLED=false
_APPLE_NFC_ENABLED=false
_APPLE_NFC_ENCRYPTION_PUBLIC_KEY=

# AI & Notifications
_WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001
_WHATSAPP_BRIDGE_API_KEY=
_TWILIO_ACCOUNT_SID=
_TWILIO_AUTH_TOKEN=
_TWILIO_FROM_NUMBER=
_LISTMONK_URL=http://listmonk:9000
_LISTMONK_API_USER=
_LISTMONK_API_TOKEN=
_AI_AGENT_BASE_URL=
_AI_AGENT_API_KEY=
