[Unit]
Description=Loyallia Full Backup

[Service]
Type=oneshot
ExecStart=/opt/loyallia/deploy/backups/backup --full --offsite
WorkingDirectory=/opt/loyallia
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
