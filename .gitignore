# =============================================================================
# Loyallia .gitignore
# =============================================================================

# Environment (NEVER commit)
.env
.env.local
.env.production

# Apple/Google/Firebase credentials (NEVER commit)
certs/*.pem
certs/*.key
certs/*.p12
certs/*.json
certs/*.csr
certs/*.cer
certs/*.p8
backend/certs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/

# Django
*.log
local_settings.py
db.sqlite3
*.sqlite3
staticfiles/
mediafiles/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
.vercel

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Docker
docker-data/

# Misc
*.bak
*.tmp

# Playwright test artifacts (NEVER commit)
frontend/test-results/
frontend/playwright-report/
frontend/.auth/
frontend/tsconfig.tsbuildinfo

# Agents (credentials, deployment docs — NEVER commit)
.agents/
backend/auth.json
frontend/.env.test

# Build artifacts & debug output
full_build.log
source_output.txt
test_output.log

# Ruff cache
.ruff_cache/

# Stray root assets
1Asset*

# =============================================================================
# Bootstrap intermediate files (NEVER commit)
# =============================================================================
.bootstrap_secrets.json
vault_secrets_rescue.json
vault_init_rescue.json
*.rescue.json
*.backup.json

# Environment files (reinforced)
.env
.env.*
!.env.example

# Certificates (reinforced)
*.pem
*.key
*.p12
*.p8
certs/
vault/certs/

# Vault data
vault/file/

# Backup temp files
backups/tmp/
backups/*.dump
backups/*.rdb
backups/*.tar.gz
